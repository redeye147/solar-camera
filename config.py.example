"""
solar-camera 設定ファイル（テンプレート）

実運用時は本ファイルを config.py にコピーし、各値を環境に合わせて書き換えてください。
config.py は .gitignore で除外されており、リポジトリには含まれません。
"""

# --- カメラ（Reolink等のRTSPカメラ） ---
CAMERA_USER = "admin"
CAMERA_PASS = "your_camera_password"
CAMERA_HOST = "192.168.1.xxx"
CAMERA_PORT = 554
CAMERA_PATH = "h264Preview_01_sub"  # カメラ機種により異なる
RTSP_URL = f"rtsp://{CAMERA_USER}:{CAMERA_PASS}@{CAMERA_HOST}:{CAMERA_PORT}/{CAMERA_PATH}"

# --- ConoHa VPS（画像配信サーバー） ---
CONOHA_HOST = "xxx.xxx.xxx.xxx"      # ConoHa VPSのIPアドレス
CONOHA_USER = "your_user"            # SSH/SCP用ユーザー名

CONOHA_REMOTE_BASE    = "/var/www/html/solar"
CONOHA_IMG_DIR        = f"{CONOHA_REMOTE_BASE}/images"
CONOHA_MONTHLY_DIR    = f"{CONOHA_REMOTE_BASE}/monthly"
CONOHA_TRIGGER        = f"{CONOHA_REMOTE_BASE}/trigger"
CONOHA_NETWORK_ALERT  = f"{CONOHA_REMOTE_BASE}/network_alert.txt"

# --- SSH ---
SSH_KEY = "/home/pi/.ssh/id_rsa"     # ConoHaへのSSH鍵パス

# --- 通知（将来拡張用） ---
GMAIL_ADDRESS = "your_address@gmail.com"

# --- ネットワーク監視 / リトライ（省略可。未設定時は既定値） ---
# GSM_CONNECTION = "nihontsushin"        # SIMドングルのNetworkManager接続名 (予備回線)
# NM_CONNECTION = "eth0-auto"            # 有線LANの接続名 (優先回線)
# LAN_IFACE = "eth0"
# LAN_METRIC = 600                       # 通常時の eth0 metric (SIMの700より優先)
# LAN_FALLBACK_METRIC = 900              # LAN不通時に下げる値 (SIM優先になる)
# PING_TARGETS = ["1.1.1.1", "8.8.8.8"]  # 疎通確認先
# NET_REBOOT_AFTER_RUNS = 6              # 復旧失敗がこの回数続くごとに再起動 (0で無効)
# NETWORK_ALERT_LOCAL = "/home/pi/solar/network_alert.txt"
# NETWORK_STATE = "/home/pi/solar/network_state.json"
# RETRY_DIR = "/home/pi/solar/retry"

# --- SIM通信量レポート（monthly_traffic.py、省略可） ---
# SIM_IFACE = "wwan0"
# SIM_LIMIT_MB = 1000
# BILLING_START_DAY = 7                  # 課金期間の開始日（7日〜翌月6日）
# CONOHA_TRAFFIC_REPORT = f"{CONOHA_REMOTE_BASE}/traffic_report.txt"
